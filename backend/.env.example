MONGO_URI=mongodb://localhost:27017/myapp
PORT=5000

# JWT signing secrets.
# SECRET_KEY is used by middleware/auth.js and the existing /api/admins/adminLogin
# route — those throw at runtime if it is not set.
# ADMIN_SECRET is used by the admin panel at /admin; it falls back to SECRET_KEY,
# then to a local dev secret, so the panel works out of the box.
SECRET_KEY=
JWT_REFRESH_SECRET=
ADMIN_SECRET=

# Push notifications. Leave blank to disable — the server logs a warning and the
# admin panel reports "Push is disabled" instead of failing.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to "production" on a deployed server. It controls whether the global
# error handler returns the error message or a generic one — unset, internal
# messages are returned, which is what you want locally and not in production.
NODE_ENV=

# Agora (live streaming and calls). Falls back to the previous owner's
# hardcoded pair if unset — see the Rekey Runbook.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Coin purchases. Without it /apis/monetisation/purchase/intent fails.
STRIPE_SECRET_KEY=

# Absolute base for uploaded-file URLs, e.g. http://192.168.200.222:5000
# Without it helpers/storage.js returns paths relative to the API.
PUBLIC_BASE_URL=
